{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contra-testnet",
  "account_id": "0a8fd0acd086e68c9b558159fac0d7a8",
  "main": "services/cloudflare/worker.mjs",
  "workers_dev": false,
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTRA_HOSTING_PLAN": "cloudflare-free",
    "CONTRA_HOSTING_COST_CEILING_USD": "0",
    "CONTRA_LIVE_SIGNING_AUTHORISED": "false",
    "CONTRA_WALLET_CONFIRMATION_AUTHORISED": "true",
    "CONTRA_CONTRACT_ACCOUNT": "contra-contestation.testnet",
    "NEAR_RPC_URL": "https://test.rpc.fastnear.com",
    "CONTRA_RPC_TIMEOUT_MS": "8000",
    "CONTRA_PUBLIC_ORIGIN": "https://contra-near.pages.dev",
    "CONTRA_FREE_REQUEST_LIMIT_DAILY": "100000",
    "CONTRA_FREE_STORAGE_LIMIT_BYTES": "5000000000",
    "CONTRA_PROVIDER_FIXTURES_ENABLED": "false",
    "META_API_BASE_URL": "https://api.meta.ai/v1/chat/completions",
    "META_MODEL": "muse-spark-1.3",
    "META_MODEL_VERIFIED": "1",
    "META_ACCOUNT_VERIFIED": "1",
    "META_CREDITS_VERIFIED": "1",
    "META_PRICING_VERIFIED": "1",
    "META_BILLING_LIMIT_VERIFIED": "0",
    "META_SERVER_BUDGET_VERIFIED": "1",
    "META_SPEND_AUTHORISED": "1",
    "META_TIMEOUT_MS": "30000",
    "META_MAX_REQUEST_MICRO_USD": "250000",
    "META_LIVE_ENABLED": "true",
    "MODAL_FUNCTION_ENDPOINT": "https://boredom407--contra-verifier-verify.us-east.modal.run",
    "MODAL_FUNCTION_ID": "ap-2wMup9xpnApV3ehbwwjKrK",
    "MODAL_MODEL_VERIFIED": "1",
    "MODAL_ACCOUNT_VERIFIED": "1",
    "MODAL_CREDITS_VERIFIED": "1",
    "MODAL_PRICING_VERIFIED": "1",
    "MODAL_BILLING_LIMIT_VERIFIED": "1",
    "MODAL_SERVER_BUDGET_VERIFIED": "1",
    "MODAL_SPEND_AUTHORISED": "1",
    "MODAL_TIMEOUT_MS": "30000",
    "MODAL_MAX_REQUEST_MICRO_USD": "250000",
    "MODAL_LIVE_ENABLED": "true"
  },
  "assets": {
    "directory": "./dist/cloudflare-static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "CONTRA_STATE", "class_name": "ContraState"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ContraState"]}
  ],
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "head_sampling_rate": 1},
    "traces": {"enabled": true, "head_sampling_rate": 0.01}
  }
}
