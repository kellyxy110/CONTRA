# Read-only NEAR Testnet runtime. This file grants no signing authority.
CONTRA_CHAIN_MODE=testnet
CONTRA_DATA_DIR=.data/testnet
HOST=127.0.0.1
PORT=4173
CONTRA_CONTRACT_ACCOUNT=contra-contestation.testnet
CONTRA_RPC_URL=https://rpc.testnet.near.org
CONTRA_RPC_TIMEOUT_MS=8000
CONTRA_STALE_AFTER_MS=120000
CONTRA_PUBLIC_ORIGIN=https://contra-near.pages.dev
CONTRA_ALLOWED_ORIGINS=https://contra-near.pages.dev
CONTRA_LIVE_SIGNING_AUTHORISED=false

# Proposed transaction limits are recorded in the authority packet. They are
# not spending permission and are not enforced by this read-only runtime file.
CONTRA_MAX_TRANSACTION_NEAR=1
CONTRA_MAX_JOURNEY_NEAR=2
