# Provider execution is disabled by default. Never put real values in Git.
CONTRA_PAID_USAGE_AUTHORIZED=0
CONTRA_CREDITS_VERIFIED=0
CONTRA_PRICING_VERIFIED=0

META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1/chat/completions
META_MODEL=muse-spark-1.3
META_TIMEOUT_MS=30000
META_MAX_REQUEST_MICRO_USD=100000
META_MAX_SPEND_USD=3
META_MODEL_VERIFIED=0
META_BILLING_LIMIT_VERIFIED=0
META_LIVE_ENABLED=false

BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1/chat/completions
BASETEN_MODEL=
BASETEN_TIMEOUT_MS=30000
BASETEN_MAX_REQUEST_MICRO_USD=100000
BASETEN_MAX_SPEND_USD=3
BASETEN_MODEL_VERIFIED=0
BASETEN_BILLING_LIMIT_VERIFIED=0
BASETEN_LIVE_ENABLED=false

# Modal API tokens are used for deployment tooling. A protected Web Function
# requires separately scoped proxy credentials and a frozen function identity.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
MODAL_FUNCTION_ENDPOINT=
MODAL_FUNCTION_ID=
MODAL_TIMEOUT_MS=30000
MODAL_MAX_REQUEST_MICRO_USD=100000
MODAL_MAX_SPEND_USD=5
MODAL_MODEL_VERIFIED=0
MODAL_BILLING_LIMIT_VERIFIED=0
MODAL_LIVE_ENABLED=false
