# Safe Node runtime defaults. Copy one of the scoped examples for local use.
CONTRA_CHAIN_MODE=unavailable
CONTRA_DATA_DIR=.data
HOST=127.0.0.1
PORT=4173

# Local Sandbox alternative:
# CONTRA_CHAIN_MODE=sandbox

# External signing and paid providers remain disabled unless their independent
# server-side gates and owner authorisation are also satisfied.
CONTRA_LIVE_SIGNING_AUTHORISED=false
