# Safe default. No chain reads or signing.
CONTRA_CHAIN_MODE=unavailable
CONTRA_DATA_DIR=.data
HOST=127.0.0.1
PORT=4173

# Local Sandbox alternative:
# CONTRA_CHAIN_MODE=sandbox

# Read-only testnet runtime. Configure only an already deployed contract.
# CONTRA_CHAIN_MODE=testnet
# CONTRA_RPC_URL=https://rpc.testnet.near.org
# CONTRA_CONTRACT_ACCOUNT=contra-example.testnet
# CONTRA_PUBLIC_ORIGIN=https://example.invalid
# CONTRA_ALLOWED_ORIGINS=https://example.invalid
# CONTRA_RPC_TIMEOUT_MS=10000
# CONTRA_STALE_AFTER_MS=120000

# Paid providers, signing keys and production secrets are intentionally absent.
